#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if [ "$(git config --bool --get knowledgeSpine.autoSync || true)" = "true" ]; then
    if ! python3 scripts/repo_sync.py sync; then
        printf '\nVERSION SAVED LOCALLY; GITHUB SYNC FAILED. Run python3 scripts/repo_sync.py sync after resolving the cause.\n' >&2
        exit 1
    fi
fi
